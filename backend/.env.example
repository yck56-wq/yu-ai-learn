# 复制为 .env 后在本地填写。不要提交实际凭证。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
WECHAT_APP_ID=
WECHAT_APP_SECRET=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=yu_ai_learn
# 测试只使用独立库 yu_ai_learn_test，不清理业务库。
MYSQL_TEST_DATABASE=yu_ai_learn_test
# 使用不少于 32 字节的随机签名密钥
JWT_SECRET=
# 私有知识库（仅后端使用）
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
KNOWLEDGE_STORAGE_DIR=backend/uploads/knowledge
CHROMA_PERSIST_DIRECTORY=backend/data/chroma
KNOWLEDGE_MAX_FILE_BYTES=20971520
KNOWLEDGE_MAX_TEXT_CHARS=2000000
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_MAX_CHUNKS=2000
